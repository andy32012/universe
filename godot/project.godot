; Godot port of the web version (index.html). See docs/handoff.md and godot/README.md.

config_version=5

[application]

config/name="宇宙"
config/description="從太陽系到宇宙邊緣"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1376
window/size/viewport_height=1032
window/vsync/vsync_mode=1
window/handheld/orientation=6
window/hdr/request_hdr_output=true
window/ios/hide_home_indicator=true
window/ios/hide_status_bar=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/driver.windows="d3d12"
rendering_device/driver.ios="metal"
rendering_device/driver.macos="metal"
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
anti_aliasing/quality/use_debanding=false
textures/canvas_textures/default_texture_filter=1
; iOS export requires ETC2/ASTC texture import (Godot fails the export silently without it)
textures/vram_compression/import_etc2_astc=true
